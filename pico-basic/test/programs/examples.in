10 REM STRINGS IN INTEGER BASIC
20 DIM A$(40), B$(20)
30 INPUT "YOUR NAME? ",B$
40 A$="HELLO, ": A$(LEN(A$)+1)=B$
50 PRINT A$
60 FOR I=LEN(B$) TO 1 STEP -1: PRINT B$(I,I);: NEXT I
70 PRINT
80 END
RUN
koide
NEW
10 REM NUMBER GUESSING
20 N=RND(100)+1: T=0
30 PRINT "GUESS 1-100"
40 INPUT "? ",G
50 T=T+1
60 IF G<N THEN PRINT "HIGHER"
70 IF G>N THEN PRINT "LOWER"
80 IF G#N THEN 40
90 PRINT "GOT IT IN ";T
100 END
RUN
50
75
88
84
NEW
10 REM LO-RES GRAPHICS DEMO
20 GR
30 FOR I=0 TO 19
40 COLOR=I MOD 15+1
50 HLIN I,39-I AT I: HLIN I,39-I AT 39-I
60 VLIN I,39-I AT I: VLIN I,39-I AT 39-I
70 NEXT I
80 VTAB 24: PRINT "PRESS A KEY";
90 IF PEEK(-16384)<128 THEN 90
100 POKE -16368,0
110 TEXT: CALL -936
120 END
90
RUN
PRINT SCRN(0,0);" ";SCRN(5,20);" ";SCRN(19,19);" ";SCRN(20,20)
