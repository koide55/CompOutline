10 REM FEATURES
20 PRINT "SUM";
30 S=0: FOR I=1 TO 10: S=S+I: NEXT I
40 PRINT " ";S
50 FORJ=10TO1STEP-3:PRINT J;" ";:NEXTJ:PRINT
60 PRINT 7/2, 7 MOD 3, -7/2, 2^10
70 PRINT (3>2) AND (2>3), (3>2) OR 0, NOT 5, 3#4, 3<>3
80 DIM A$(20), B(5)
90 A$="HELLO": A$(LEN(A$)+1)=", WORLD"
100 PRINT A$; " "; LEN(A$); " "; A$(1,5); "|"; A$(8)
110 IF A$(1,5)="HELLO" THEN PRINT "STR EQ OK"
120 FOR I=0 TO 5: B(I)=I*I: NEXT I: PRINT B(5)
130 GOSUB 500: PRINT "BACK"
140 IF 0 THEN PRINT "NO": PRINT "IB QUIRK: RUNS ANYWAY"
150 IF 1 THEN 170
160 PRINT "SKIPPED?"
170 PRINT ASC("A"), ABS(-5), SGN(-9)
180 POKE 768,42: PRINT PEEK(768)
190 X=RND(10): IF X>=0 AND X<10 THEN PRINT "RND OK"
200 LENGTH=3: PRINT LENGTH
210 PRINT "A","B","C"
220 END
500 PRINT "IN SUB": RETURN
RUN
LIST 130,150
PRINT 32767+1
PRINT "CONT"
FOR I=1 TO 3: PRINT I;: NEXT I: PRINT
