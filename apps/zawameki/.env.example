# ---- 必ず設定する ----
# 教員の入口（/teacher）の Basic 認証。未設定だと起動のたびに仮のパスワードをログに出す
ZAWAMEKI_TEACHER_USER=teacher
ZAWAMEKI_TEACHER_PASSWORD=
# QR コードと入室 URL に使う、学生から見える URL（末尾の / は不要）。HTTPS なら https://
ZAWAMEKI_PUBLIC_URL=https://arena.koidelab.net:8100

# ---- 必要なら変える ----
# ホスト側で公開するポート（HTTPS を nginx コンテナで出すときは使わない。
# ホストの nginx を使うときは 127.0.0.1:8101 にする）
ZAWAMEKI_PUBLISH=8100
# 学生番号の形（大文字にし、空白とハイフンを除いてから照合する）
ZAWAMEKI_STUDENT_ID_PATTERN=^[0-9A-Z]{5,12}$
# 伏せ字にする語（カンマ区切り）
ZAWAMEKI_NG_WORDS=
# CSV やレポートに出す時刻のタイムゾーン（既定は Dockerfile の Asia/Tokyo）
# TZ=Asia/Tokyo
# 開いたまま忘れた部屋を自動で閉じるまでの時間
ZAWAMEKI_ROOM_HOURS=4
# 前段に nginx 等を置くとき、その IP（X-Forwarded-* を信じる相手）
ZAWAMEKI_TRUSTED_PROXIES=127.0.0.1

# ---- HTTPS を arena の Caddy に任せるとき（docker-compose.caddy.yml）----
# Caddy がつながっている Docker ネットワーク（README の手順 1 で調べる）
ZAWAMEKI_CADDY_NETWORK=cyber-arena_default

# ---- HTTPS を nginx コンテナで出すとき（docker-compose.https.yml）----
# 証明書の置き場（live/arena.koidelab.net/ の親）
ZAWAMEKI_LETSENCRYPT_DIR=/etc/letsencrypt
# nginx が HTTPS を受けるホスト側のポート
ZAWAMEKI_HTTPS_PORT=8100

# ---- アプリが HTTPS を直接出す場合だけ（nginx を使わないとき）----
# ZAWAMEKI_SSL_CERTFILE=/etc/letsencrypt/live/arena.koidelab.net/fullchain.pem
# ZAWAMEKI_SSL_KEYFILE=/etc/letsencrypt/live/arena.koidelab.net/privkey.pem
