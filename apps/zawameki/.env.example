# ---- 必ず設定する ----
# 教員の入口（/teacher）の Basic 認証。未設定だと起動のたびに仮のパスワードをログに出す
ZAWAMEKI_TEACHER_USER=teacher
ZAWAMEKI_TEACHER_PASSWORD=
# QR コードと入室 URL に使う、学生から見える URL（末尾の / は不要）
ZAWAMEKI_PUBLIC_URL=http://arena.koidelab.net:8100

# ---- 必要なら変える ----
# ホスト側で公開するポート
ZAWAMEKI_PUBLISH=8100
# 学生番号の形（大文字にし、空白とハイフンを除いてから照合する）
ZAWAMEKI_STUDENT_ID_PATTERN=^[0-9A-Z]{5,12}$
# 伏せ字にする語（カンマ区切り）
ZAWAMEKI_NG_WORDS=
# 開いたまま忘れた部屋を自動で閉じるまでの時間
ZAWAMEKI_ROOM_HOURS=4
# 前段に nginx 等を置くとき、その IP（X-Forwarded-* を信じる相手）
ZAWAMEKI_TRUSTED_PROXIES=127.0.0.1

# ---- HTTPS を直接出す場合だけ（前段に nginx 等を置かないとき）----
# ZAWAMEKI_SSL_CERTFILE=/etc/letsencrypt/live/arena.koidelab.net/fullchain.pem
# ZAWAMEKI_SSL_KEYFILE=/etc/letsencrypt/live/arena.koidelab.net/privkey.pem
