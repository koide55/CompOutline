<table>
<tr><td style="padding:4px 12px 4px 0">RAID 5 で使える容量</td><td style="padding:4px 0">{1:NUMERICAL:=20:0} TB</td></tr>
<tr><td style="padding:4px 12px 4px 0">RAID 5 が耐えられる故障</td><td style="padding:4px 0">{1:NUMERICAL:=1:0} 台</td></tr>
<tr><td style="padding:4px 12px 4px 0">RAID 6 で使える容量</td><td style="padding:4px 0">{1:NUMERICAL:=16:0} TB</td></tr>
<tr><td style="padding:4px 12px 4px 0">RAID 6 が耐えられる故障</td><td style="padding:4px 0">{1:NUMERICAL:=2:0} 台</td></tr>
</table>]]></text></questiontext>
